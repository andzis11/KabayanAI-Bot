# =========================
# KABAYAN AGENT ENV TEMPLATE
# Copy this file to `.env` and fill with your real values.
# =========================

# --- TELEGRAM (Required) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here
# Optional fallback key (legacy):
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
BOT_USERNAME=KabayanBot

# --- SOLANA / RPC (Required) ---
SOLANA_PRIVATE_KEY=your_base58_private_key_here
HELIUS_API_KEY=your_helius_api_key_here

# --- AI PROVIDERS (At least one required) ---
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- AGENT CONFIG (Optional with defaults) ---
DAILY_CAPITAL=1
BASE_RISK_PERCENT=2
ALPHA_MULTIPLIER=1.5
FEE_CAP=0.5

# --- MEV BOT (Optional) ---
JITO_API_KEY=
JITO_TIP_LAMPORTS=50000
MEV_ENABLED=false
MEV_MIN_SPREAD_PERCENT=2
MEV_TRADE_SIZE_SOL=0.1
MEV_MIN_SOL_SIZE=0.5
MEV_MAX_SLIPPAGE=10

# --- ACCESS / REPORTING (Optional) ---
WHITELIST_MODE=open
DAILY_REPORT_CHAT_ID=

# --- APIs (Optional override) ---
DEXSCREENER_API=https://api.dexscreener.com/latest/dex/tokens/
